<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d"
        x:Class="Obcred.Views.SettingsWindow"
        Title="Поставки — Obcred"
        Icon="/logo64.ico"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandBackground}"
        xmlns:vm="using:Obcred.ViewModels"
        x:DataType="vm:SettingsViewModel"
        >

    <StackPanel Margin="24" Spacing="0">
        <TextBlock Text="Поставување" FontSize="19" FontWeight="SemiBold" LetterSpacing="-0.2" Foreground="{StaticResource BrandText}"/>
        <TextBlock Text="Вашиот дигитален сертификат, податоци за компанијата и УЈП околината."
                   Classes="Muted" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

        <Border Classes="Card">
            <StackPanel Spacing="0">

                <!-- CERTIFICATE -->
                <TextBlock Text="ДИГИТАЛЕН СЕРТИФИКАТ" Classes="SectionLabel" Margin="0,0,0,10"/>

                <Label Content="USB токен / складиште на сертификати на Windows"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                    <TextBox Grid.Column="0" Text="{Binding CertThumbprint}" IsReadOnly="True" Classes="ReadOnlyField"
                             PlaceholderText="Не е избран сертификат"/>
                    <Button Grid.Column="1" Content="Вчитај USB" Command="{Binding SelectUsbCertificateCommand}" Classes="SecondaryActionBtn"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,12">
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="или" Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="10,0"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Center"/>
                </Grid>

                <Label Content=".pfx датотека со сертификат"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                    <TextBox Grid.Column="0" Text="{Binding CertPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Classes="ReadOnlyField"
                             PlaceholderText="Не е избрана датотека"/>
                    <Button Grid.Column="1" Content="Прелистај…" Command="{Binding BrowseCertificateCommand}" Classes="SecondaryActionBtn"/>
                </Grid>

                <Label Content="Лозинка за .pfx"/>
                <TextBox Text="{Binding CertPassword, UpdateSourceTrigger=PropertyChanged}" PasswordChar="•"
                         PlaceholderText="Оставете празно кога користите USB токен"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,18"/>

                <!-- COMPANY -->
                <TextBlock Text="КОМПАНИЈА" Classes="SectionLabel" Margin="0,0,0,10"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0">
                        <Label Content="ЕДБ на компанијата"/>
                        <TextBox Text="{Binding SellerEdb, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="EUJP-ID (од порталот)"/>
                        <TextBox Text="{Binding EujpId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Префикс за број на фактура (опционално)"/>
                <TextBox Text="{Binding InvoiceNumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Оставете празно за 2026-0001"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,18"/>

                <!-- ENVIRONMENT -->
                <TextBlock Text="ОКОЛИНА" Classes="SectionLabel" Margin="0,0,0,8"/>
                <CheckBox Content="Испрати до ПРОДУКЦИЈА (во живо) — реални фискални фактури"
                          IsChecked="{Binding UseProductionEnvironment}"/>
                <TextBlock Text="Оставете неозначено за да ја користите тест-околината на УЈП."
                           Classes="Muted" FontSize="12" Margin="28,0,0,20"/>

                <Button Content="Провери и зачувај"
                        Command="{Binding SaveAndVerifyCommand}"
                        Classes="PrimaryActionBtn" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote" Margin="0,12,0,0" TextAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>