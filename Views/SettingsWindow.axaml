<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Obcred.Views.SettingsWindow"
        Title="Settings"
        Width="480"
        SizeToContent="Height"
        Background="{StaticResource BrandBackground}"
        xmlns:vm="using:Obcred.ViewModels"
        x:DataType="vm:SettingsViewModel"
        >

    <StackPanel Margin="28" Spacing="4">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <PathIcon Data="{StaticResource Settings}" Width="18" Height="18" Foreground="{StaticResource BrandAccent}" Margin="0,0,10,0"/>
            <TextBlock Text="Software Setup" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandText}"/>
        </StackPanel>
        <TextBlock Text="Configure your digital certificate, company details and UJP environment."
                   Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <Border Classes="Card" Padding="20">
            <StackPanel Spacing="4">

                <Label Content="1. Digital Certificate Source" FontWeight="Bold" Foreground="{StaticResource BrandText}" Padding="0,0,0,6"/>

                <Grid ColumnDefinitions="*,110" Margin="0,0,0,8">
                    <TextBox Text="{Binding CertThumbprint}" IsReadOnly="True" Classes="ReadOnlyField" Grid.Column="0"/>
                    <Button Content="Load USB" Command="{Binding SelectUsbCertificateCommand}" Grid.Column="1" Classes="SecondaryActionBtn" Height="36" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="— OR —" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,2,0,8"/>

                <Grid ColumnDefinitions="*,110" Margin="0,0,0,8">
                    <TextBox Text="{Binding CertPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Classes="ReadOnlyField" Grid.Column="0"/>
                    <Button Content="Browse .pfx" Command="{Binding BrowseCertificateCommand}" Grid.Column="1" Classes="SecondaryActionBtn" Height="36" Margin="8,0,0,0"/>
                </Grid>

                <Label Content="PFX Password (leave blank if USB)" Margin="0,4,0,0"/>
                <TextBox Text="{Binding CertPassword, UpdateSourceTrigger=PropertyChanged}" PasswordChar="•" Margin="0,0,0,16"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,0,0,16"/>

                <Label Content="2. Your Company EDB" FontWeight="Bold" Foreground="{StaticResource BrandText}"/>
                <TextBox Text="{Binding SellerEdb, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <Label Content="3. EUJP-ID (From Portal)" FontWeight="Bold" Foreground="{StaticResource BrandText}"/>
                <TextBox Text="{Binding EujpId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                <Label Content="4. Invoice Number Prefix (optional)" FontWeight="Bold" Foreground="{StaticResource BrandText}"/>
                <TextBox Text="{Binding InvoiceNumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                         Watermark="Leave blank for 2026-0001" Margin="0,0,0,14"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,0,0,16"/>

                <Label Content="5. Environment" FontWeight="Bold" Foreground="{StaticResource BrandText}"/>
                <CheckBox Content="Use PRODUCTION (LIVE) environment — sends real fiscal invoices"
                          IsChecked="{Binding UseProductionEnvironment}" Margin="0,4,0,4"/>
                <TextBlock Text="Leave unchecked to use the UJP TEST sandbox."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,0,0,20"/>

                <Button Content="Verify &amp; Save Setup"
                        Command="{Binding SaveAndVerifyCommand}"
                        Classes="PrimaryActionBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0" Foreground="{StaticResource BrandDanger}"
                           TextWrapping="Wrap" HorizontalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
