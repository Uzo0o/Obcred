<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="using:Avalonia.Data.Converters"
        mc:Ignorable="d"
        x:Class="Obcred.Views.SettingsWindow"
        Title="Settings — Obcred"
        Icon="/logo64.ico"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrandBackground}"
        xmlns:vm="using:Obcred.ViewModels"
        x:DataType="vm:SettingsViewModel"
        >

    <StackPanel Margin="24" Spacing="0">
        <TextBlock Text="Setup" FontSize="19" FontWeight="SemiBold" LetterSpacing="-0.2" Foreground="{StaticResource BrandText}"/>
        <TextBlock Text="Your digital certificate, company details and the UJP environment."
                   Classes="Muted" FontSize="13" Margin="0,4,0,18" TextWrapping="Wrap"/>

        <Border Classes="Card">
            <StackPanel Spacing="0">

                <!-- CERTIFICATE -->
                <TextBlock Text="DIGITAL CERTIFICATE" Classes="SectionLabel" Margin="0,0,0,10"/>

                <Label Content="USB token / Windows certificate store"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                    <TextBox Grid.Column="0" Text="{Binding CertThumbprint}" IsReadOnly="True" Classes="ReadOnlyField"
                             PlaceholderText="No certificate selected"/>
                    <Button Grid.Column="1" Content="Load USB" Command="{Binding SelectUsbCertificateCommand}" Classes="SecondaryActionBtn"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto,*" Margin="0,0,0,12">
                    <Rectangle Grid.Column="0" Height="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="or" Foreground="{StaticResource TextFaint}" FontSize="11.5" Margin="10,0"/>
                    <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderLight}" VerticalAlignment="Center"/>
                </Grid>

                <Label Content=".pfx certificate file"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,12">
                    <TextBox Grid.Column="0" Text="{Binding CertPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Classes="ReadOnlyField"
                             PlaceholderText="No file selected"/>
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCertificateCommand}" Classes="SecondaryActionBtn"/>
                </Grid>

                <Label Content=".pfx password"/>
                <TextBox Text="{Binding CertPassword, UpdateSourceTrigger=PropertyChanged}" PasswordChar="•"
                         PlaceholderText="Leave blank when using a USB token"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,18"/>

                <!-- COMPANY -->
                <TextBlock Text="COMPANY" Classes="SectionLabel" Margin="0,0,0,10"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                    <StackPanel Grid.Column="0">
                        <Label Content="Company EDB"/>
                        <TextBox Text="{Binding SellerEdb, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Label Content="EUJP-ID (from the portal)"/>
                        <TextBox Text="{Binding EujpId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <Label Content="Invoice number prefix (optional)"/>
                <TextBox Text="{Binding InvoiceNumberPrefix, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Leave blank for 2026-0001"/>

                <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,20,0,18"/>

                <!-- ENVIRONMENT -->
                <TextBlock Text="ENVIRONMENT" Classes="SectionLabel" Margin="0,0,0,8"/>
                <CheckBox Content="Send to PRODUCTION (live) — real fiscal invoices"
                          IsChecked="{Binding UseProductionEnvironment}"/>
                <TextBlock Text="Leave unchecked to use the UJP test sandbox."
                           Classes="Muted" FontSize="12" Margin="28,0,0,20"/>

                <Button Content="Verify &amp; save"
                        Command="{Binding SaveAndVerifyCommand}"
                        Classes="PrimaryActionBtn" HorizontalAlignment="Stretch"/>

                <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote" Margin="0,12,0,0" TextAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
