<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:DataType="viewModels:HistoryViewModel"
             x:Class="Obcred.Views.InvoiceHistoryView">

    <Grid Classes="PageRoot" Margin="28,24,28,28" RowDefinitions="Auto,*">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <!-- TITLE + REFRESH -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
            <TextBlock Grid.Column="0" Text="Invoice History" Classes="PageTitleStyle" Margin="0"/>
            <Button Grid.Column="1" Command="{Binding LoadCommand}" Classes="PrimaryActionBtn" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource IconHistory}" Width="13" Height="13"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- LIST + DETAIL -->
        <Grid Grid.Row="1" ColumnDefinitions="1.6*,1*">

            <!-- LEFT: list of submitted invoices -->
            <Border Grid.Column="0" Classes="Card" Padding="12" Margin="0,0,16,0">
                <DataGrid ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Invoice No." Binding="{Binding DocNumber}" Width="*"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding IssueDate}" Width="110"/>
                        <DataGridTextColumn Header="Buyer" Binding="{Binding BuyerName}" Width="1.4*"/>
                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding GrossAmount, StringFormat='{}{0:N2}'}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- RIGHT: detail of the selected invoice -->
            <Border Grid.Column="1" Classes="Card">
                <ScrollViewer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Border Classes="CardHeaderAccent"/>
                            <TextBlock Text="Selected Invoice" Classes="CardHeaderStyle" Margin="0"/>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNotNull}}" Spacing="4">
                            <TextBlock Text="{Binding SelectedInvoice.DocNumber, StringFormat='No.: {0}'}"
                                       FontWeight="SemiBold" Foreground="{StaticResource BrandText}"/>
                            <TextBlock Text="{Binding SelectedInvoice.BuyerName, StringFormat='Buyer: {0}'}"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding SelectedInvoice.IssueDate, StringFormat='Issued: {0}'}"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding SelectedInvoice.GrossAmount, StringFormat='Total: {0:N2} MKD'}"
                                       Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="{Binding SelectedInvoice.Status, StringFormat='Status: {0}'}"
                                       FontWeight="Bold" Foreground="{StaticResource BrandAccent}" Margin="0,0,0,8"/>

                            <Button Command="{Binding ExportPdfCommand}" Classes="SecondaryActionBtn" HorizontalAlignment="Left" Margin="0,4,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSave}" Width="13" Height="13"/>
                                    <TextBlock Text="Save PDF"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandSuccess}"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"/>

                            <TextBlock Text="UJP Response" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource InputBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                                <SelectableTextBlock Text="{Binding SelectedInvoice.UjpResponse}"
                                                     TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrandText}"/>
                            </Border>

                            <TextBlock Text="Signed Document (JWS)" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <Border Background="{StaticResource InputBackground}" CornerRadius="8" Padding="10">
                                <SelectableTextBlock Text="{Binding SelectedInvoice.SignedJws}"
                                                     TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                     MaxHeight="160"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Select an invoice to see its details."
                                   Foreground="#94A3B8" FontSize="13"
                                   IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNull}}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
