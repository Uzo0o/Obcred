<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:local="using:Obcred.Converters"
             x:DataType="viewModels:HistoryViewModel"
             x:Class="Obcred.Views.InvoiceHistoryView">

    <Grid Classes="PageRoot" Margin="24,20,24,24" ColumnDefinitions="1.6*,1*" ColumnSpacing="16">

        <!-- LEFT: list of submitted invoices -->
        <Border Grid.Column="0" Classes="Card D1" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,16,16,14">
                    <Border Grid.Column="0" Classes="IconAvatar" Margin="0,0,12,0">
                        <PathIcon Data="{StaticResource IconHistory}"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="Испратени фактури" Classes="CardHeaderStyle" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Command="{Binding LoadCommand}" Classes="SecondaryActionBtn" Padding="10,0" ToolTip.Tip="Освежи">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Освежи" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,10,10" ClipToBounds="True">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Invoices}"
                                  SelectedItem="{Binding SelectedInvoice}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Бр. на фактура" Binding="{Binding DocNumber}" Width="130"/>
                                <DataGridTextColumn Header="Датум" Binding="{Binding IssueDate}" Width="115"/>
                                <DataGridTextColumn Header="Купувач" Binding="{Binding BuyerName}" Width="*"/>
                                <DataGridTextColumn Header="Вкупно" Binding="{Binding GrossAmount, StringFormat='{}{0:N2}'}" Width="130"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Classes="EmptyState"
                                    IsVisible="{Binding Invoices.Count, Converter={x:Static local:IsZeroConverter.Instance}}">
                            <PathIcon Data="{StaticResource IconHistory}"/>
                            <TextBlock Text="Сè уште нема испратени фактури."/>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT: detail of the selected invoice -->
        <Border Grid.Column="1" Classes="Card D2">
            <Panel>
                <ScrollViewer IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <Border Classes="IconAvatar">
                                <PathIcon Data="{StaticResource Document}"/>
                            </Border>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedInvoice.DocNumber}" Classes="CardHeaderStyle" FontSize="17"/>
                                <TextBlock Text="{Binding SelectedInvoice.BuyerName}" Classes="Muted"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12" Margin="0,0,0,18">
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Label Content="Издадена"/>
                                <TextBlock Text="{Binding SelectedInvoice.IssueDate}" Classes="FieldValue"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <Label Content="Статус"/>
                                <TextBlock Text="{Binding SelectedInvoice.Status}" Classes="FieldValue"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <Label Content="Вкупно"/>
                                <TextBlock Text="{Binding SelectedInvoice.GrossAmount, StringFormat='{}{0:N2} MKD'}" Classes="FieldValue" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Button Command="{Binding ExportPdfCommand}" Classes="SecondaryActionBtn" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Зачувај PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote" Margin="0,8,0,0"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>

                        <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,18,0,16"/>

                        <TextBlock Text="ОДГОВОР ОД УЈП" Classes="SectionLabel" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                CornerRadius="6" Padding="10" Margin="0,0,0,14">
                            <SelectableTextBlock Text="{Binding SelectedInvoice.UjpResponse}"
                                                 TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource BrandText}"/>
                        </Border>

                        <TextBlock Text="ПОТПИШАН ДОКУМЕНТ (JWS)" Classes="SectionLabel" Margin="0,0,0,6"/>
                        <Border Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                CornerRadius="6" Padding="10">
                            <SelectableTextBlock Text="{Binding SelectedInvoice.SignedJws}"
                                                 TextWrapping="Wrap" FontSize="11" FontFamily="Consolas, Courier New, monospace"
                                                 Foreground="{StaticResource TextMuted}" MaxHeight="160"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Classes="EmptyState"
                            IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNull}}">
                    <PathIcon Data="{StaticResource Document}"/>
                    <TextBlock Text="Изберете фактура за да ги видите деталите."/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>