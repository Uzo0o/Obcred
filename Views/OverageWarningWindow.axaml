<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        x:Class="Obcred.Views.OverageWarningWindow"
        Title="Plan limit reached — Obcred"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrandBackground}">

    <StackPanel Margin="28" Spacing="4">

        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="Bold"
                   Foreground="{StaticResource BrandText}" TextWrapping="Wrap"/>

        <TextBlock x:Name="IntroText" FontSize="13" Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap" Margin="0,10,0,4"/>
        <TextBlock x:Name="CostText" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource BrandDanger}" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock x:Name="ChoiceText" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,20"/>

        <StackPanel Spacing="8">
            <Button x:Name="ChoosePlanButton" Content="Choose a plan instead"
                    Classes="SecondaryActionBtn" HorizontalAlignment="Stretch"/>
            <Button x:Name="StayOnPlanButton"
                    Classes="PrimaryActionBtn" HorizontalAlignment="Stretch"/>
        </StackPanel>

    </StackPanel>
</Window>