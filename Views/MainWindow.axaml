<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Obcred.ViewModels"
        xmlns:views="using:Obcred.Views"
        x:Class="Obcred.Views.MainWindow"
        x:DataType="vm:InvoiceViewModel"
        Icon="/logo64.ico"
        Title="Obcred"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="{StaticResource SurfaceWhite}" CornerRadius="16" ClipToBounds="True"
            BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
            BoxShadow="0 20 60 -10 #33000000">
        <Grid ColumnDefinitions="248,*">

            <!-- ============ SIDEBAR ============ -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBackground}" RowDefinitions="76,*,Auto">

                <!-- BRAND -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0" Spacing="12">
                    <Border Width="28" Height="28" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#7AB4FF" Offset="0"/>
                                <GradientStop Color="#2E86FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="Obcred" FontWeight="Bold" FontSize="19" Foreground="White" LetterSpacing="0.3"/>
                </StackPanel>

                <!-- NAV -->
                <StackPanel Grid.Row="1" Margin="16,12,16,0" Spacing="2">
                    <RadioButton Classes="NavItem" IsChecked="True" Click="NavNewInvoice_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Document}" Width="16" Height="16"/>
                            <TextBlock Text="New Invoice" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" IsEnabled="False" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconUsers}" Width="16" Height="16"/>
                            <TextBlock Text="Client List" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" Click="NavHistory_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource IconHistory}" Width="16" Height="16"/>
                            <TextBlock Text="Invoice History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- SETTINGS (bottom) -->
                <StackPanel Grid.Row="2" Margin="16,0,16,16">
                    <Rectangle Height="1" Fill="#1E293B" Margin="4,0,4,12"/>
                    <Button Classes="NavItemBtn" Click="OpenSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource Settings}" Width="16" Height="16"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ============ MAIN CONTENT ============ -->
            <Grid Grid.Column="1" RowDefinitions="56,*">

                <!-- TOP BAR -->
                <Grid Grid.Row="0" Background="{StaticResource SurfaceWhite}" PointerPressed="TopBar_PointerPressed">
                    <Border BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="16">
                                <TextBlock Text="Create New Invoice" FontWeight="Bold" Foreground="{StaticResource BrandText}" FontSize="16"/>

                                <Border IsVisible="{Binding IsTest}" Classes="BannerSuccess">
                                    <TextBlock Text="{Binding EnvironmentBanner}" FontWeight="Bold" FontSize="12" Foreground="#059669"/>
                                </Border>
                                <Border IsVisible="{Binding IsProduction}" Classes="BannerDanger">
                                    <TextBlock Text="{Binding EnvironmentBanner}" FontWeight="Bold" FontSize="12" Foreground="#DC2626"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center" Spacing="0">
                                <Button Click="Minimize_Click" Classes="WindowControlBtnStyle CyanWindowBtnStyle">
                                    <PathIcon Data="{StaticResource Minimize}" Width="10" Height="10"/>
                                </Button>
                                <Button Click="Maximize_Click" Classes="WindowControlBtnStyle CyanWindowBtnStyle">
                                    <PathIcon Data="{StaticResource Expand}" Width="11" Height="11"/>
                                </Button>
                                <Button Click="Close_Click" Classes="WindowControlBtnStyle RedWindowBtnStyle" Margin="16,0,0,0">
                                    <PathIcon Data="{StaticResource Close}" Width="10" Height="10"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW CONTAINER -->
                <Grid Grid.Row="1" Background="{StaticResource BrandBackground}">
                    <ContentControl x:Name="PageHost"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
