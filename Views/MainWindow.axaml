<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Obcred.ViewModels"
        xmlns:views="using:Obcred.Views"
        xmlns:local="using:Obcred.Converters"
        x:Class="Obcred.Views.MainWindow"
        x:DataType="vm:InvoiceViewModel"
        Icon="/logo64.ico"
        Title="Obcred"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceWhite}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48"
        WindowDecorationsTheme="{StaticResource ObcredWindowDecorations}">

    <!-- The OS keeps its own caption buttons (minimize / maximize / close) and window
         shadow, and our top bar + sidebar extend up into the title-bar area, so the
         app gets snap layouts, double-click-to-maximize and a proper frame for free.
         OffScreenMargin keeps content from sliding under the screen edge when maximized. -->
    <Grid ColumnDefinitions="224,*" Margin="{Binding $parent[Window].OffScreenMargin}">

        <!-- ============ SIDEBAR ============ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <Grid RowDefinitions="48,*,Auto">

                <!-- BRAND (sits inside the draggable title-bar strip) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" Spacing="10"
                            IsHitTestVisible="False">
                    <Image Source="avares://Obcred/Assets/Logo.png" Width="28" Height="28" VerticalAlignment="Center"/>
                    <TextBlock Text="Obcred" FontWeight="SemiBold" FontSize="18" LetterSpacing="-0.2"
                               Foreground="{StaticResource SidebarText}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- NAV -->
                <StackPanel Grid.Row="1" Margin="12,14,12,0" Spacing="2">
                    <RadioButton Classes="NavItem" IsChecked="True" Click="NavNewInvoice_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Document}" Width="15" Height="15"/>
                            <TextBlock Text="New Invoice" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" Click="NavClientList_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconUsers}" Width="15" Height="15"/>
                            <TextBlock Text="Clients" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" Click="NavHistory_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconHistory}" Width="15" Height="15"/>
                            <TextBlock Text="Invoice History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" Click="NavReceivedInvoices_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconInbox}" Width="15" Height="15"/>
                            <TextBlock Text="Received Invoices" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="NavItem" Click="NavPdfTemplate_Click" GroupName="MainNav">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconLayout}" Width="15" Height="15"/>
                            <TextBlock Text="PDF Template" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- PLAN + SETTINGS (bottom) -->
                <StackPanel Grid.Row="2" Margin="12,0,12,12" Spacing="8">

                    <!-- PLAN / USAGE BADGE -->
                    <Border Background="{StaticResource SidebarHoverBackground}" CornerRadius="8"
                            Padding="12,10" Cursor="Hand"
                            PointerPressed="UsageBadge_PointerPressed"
                            ToolTip.Tip="Change your plan">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding UsagePlanLabel}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarText}"/>
                                <TextBlock Grid.Column="1" Text="Change" FontSize="11"
                                           Foreground="{StaticResource SidebarTextMuted}"/>
                            </Grid>
                            <TextBlock Text="{Binding UsageCountLabel}" FontSize="11.5"
                                       Foreground="{StaticResource SidebarTextMuted}"/>
                            <Border Height="4" CornerRadius="2" Background="{StaticResource SidebarDivider}"
                                    IsVisible="{Binding !UsageIsUnlimited}">
                                <Border CornerRadius="2" Background="{StaticResource BrandAccent}"
                                        HorizontalAlignment="Left"
                                        Width="{Binding UsageProgressFraction, Converter={x:Static local:FractionToWidthConverter.Instance}, ConverterParameter=176}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Classes="NavItemBtn" Click="OpenSettings_Click">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Settings}" Width="15" Height="15"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ MAIN CONTENT ============ -->
        <Grid Grid.Column="1" RowDefinitions="48,*">

            <!-- TOP BAR — lives in the title-bar strip; the right edge stays clear for the
                 system caption buttons. -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceWhite}"
                    BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1"
                    PointerPressed="TopBar_PointerPressed">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,150,0" Spacing="12">
                    <TextBlock x:Name="PageTitle" Text="New Invoice" FontWeight="SemiBold" FontSize="14"
                               Foreground="{StaticResource BrandText}" VerticalAlignment="Center"/>

                    <Border IsVisible="{Binding IsTest}" Classes="BannerSuccess" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EnvironmentBanner}" Foreground="{StaticResource BrandSuccess}"/>
                    </Border>
                    <Border IsVisible="{Binding IsProduction}" Classes="BannerDanger" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EnvironmentBanner}" Foreground="{StaticResource BrandDanger}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- VIEW CONTAINER -->
            <Grid Grid.Row="1" Background="{StaticResource BrandBackground}">
                <ContentControl x:Name="PageHost"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
