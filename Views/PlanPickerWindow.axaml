<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Obcred.Views.PlanPickerWindow"
        Title="Choose a plan — Obcred"
        Width="460"
        SizeToContent="Height"
        MaxHeight="720"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrandBackground}"
        xmlns:vm="using:Obcred.ViewModels"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:local="using:Obcred.Converters"
        x:DataType="vm:PlanPickerViewModel">

    <ScrollViewer>
    <StackPanel Margin="28" Spacing="4">

        <TextBlock Text="Choose a plan" FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource BrandText}"/>
        <TextBlock Text="{Binding CurrentPlanLabel}" FontSize="12.5"
                   Foreground="{StaticResource TextMuted}" Margin="0,2,0,4"/>
        <TextBlock Text="You can move up to a higher plan any time. Once you switch, you can't move back down until next month."
                   FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Error banner -->
        <Border Classes="BannerDanger" IsVisible="{Binding HasError}" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandDanger}"
                       FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <!-- Plan list — hidden while a confirmation is pending -->
        <ItemsControl ItemsSource="{Binding Plans}" IsVisible="{Binding PendingPlan, Converter={x:Static conv:ObjectConverters.IsNull}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource InputBackground}" CornerRadius="10"
                            Padding="14,12" Margin="0,0,0,8" BorderThickness="1.5"
                            BorderBrush="{Binding IsCurrent, Converter={x:Static local:BoolToBrandAccentConverter.Instance}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               FontSize="14" Foreground="{StaticResource BrandText}"/>
                                    <Border Background="{StaticResource BrandAccent}" CornerRadius="4"
                                            Padding="6,1" IsVisible="{Binding IsCurrent}">
                                        <TextBlock Text="Current" FontSize="10" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding LimitLabel}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding PriceLabel}" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Choose" Classes="SecondaryActionBtn"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding !IsCurrent}" IsEnabled="{Binding !IsDowngrade}"
                                    Command="{Binding $parent[ItemsControl].((vm:PlanPickerViewModel)DataContext).SelectPlanCommand}"
                                    CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Confirmation panel — the required "are you sure" step for a plan switch -->
        <StackPanel IsVisible="{Binding PendingPlan, Converter={x:Static conv:ObjectConverters.IsNotNull}}" Spacing="12">
            <Border Background="{StaticResource InputBackground}" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource BrandText}">
                        <Run Text="Switch to"/> <Run Text="{Binding PendingPlan.DisplayName}"/><Run Text="?"/>
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                        <Run Text="{Binding PendingPlan.PriceLabel}"/><Run Text=" — "/><Run Text="{Binding PendingPlan.LimitLabel}"/><Run Text=" included."/>
                    </TextBlock>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                               Text="Extra invoices beyond that are 14 MKD each, billed at the end of the month."/>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource BrandDanger}" TextWrapping="Wrap"
                               Text="This applies for the rest of this month, and you won't be able to move to a lower plan again until next month."/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*">
                <Button Grid.Column="0" Content="Cancel" Classes="SecondaryActionBtn"
                        HorizontalAlignment="Stretch" Margin="0,0,6,0"
                        Command="{Binding CancelPendingCommand}"/>
                <Button Grid.Column="1" Content="Confirm switch" Classes="PrimaryActionBtn"
                        HorizontalAlignment="Stretch" Margin="6,0,0,0"
                        Command="{Binding ConfirmPendingCommand}"/>
            </Grid>
        </StackPanel>

        <TextBlock Text="Loading..." IsVisible="{Binding IsBusy}" Foreground="{StaticResource TextMuted}"
                   FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0"/>

    </StackPanel>
    </ScrollViewer>
</Window>
