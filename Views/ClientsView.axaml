<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:DataType="viewModels:ClientsViewModel"
             x:Class="Obcred.Views.ClientsView">

    <Grid Classes="PageRoot" Margin="24,20,24,24" ColumnDefinitions="1.1*,1.6*" ColumnSpacing="16">

        <!-- LEFT: searchable client list -->
        <Border Grid.Column="0" Classes="Card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,16,12" ColumnSpacing="8">
                    <Panel Grid.Column="0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search by name or EDB" Padding="34,0,10,0"/>
                        <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13"
                                  Foreground="{StaticResource TextFaint}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                  IsHitTestVisible="False"/>
                    </Panel>
                    <Button Grid.Column="1" Command="{Binding LoadCommand}" IsEnabled="{Binding IsNotBusy}"
                            Classes="SecondaryActionBtn" Padding="10,0" ToolTip.Tip="Refresh">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,10,10" ClipToBounds="True">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClient}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="EDB" Binding="{Binding Edb}" Width="120"/>
                                <DataGridTextColumn Header="City" Binding="{Binding City}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Classes="EmptyState" IsVisible="{Binding !HasClients}">
                            <PathIcon Data="{StaticResource IconUsers}"/>
                            <TextBlock Text="No saved clients yet. They appear here after you look one up on the invoice screen."/>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT: selected client's details + their invoice history -->
        <Border Grid.Column="1" Classes="Card">
            <Panel>
                <Grid IsVisible="{Binding SelectedClient, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

                    <!-- Client identity -->
                    <TextBlock Grid.Row="0" Text="{Binding SelectedClient.Name}" Classes="CardHeaderStyle" FontSize="17" Margin="0,0,0,2"/>
                    <TextBlock Grid.Row="1" Classes="Muted" Margin="0,0,0,18">
                        <Run Text="EDB"/> <Run Text="{Binding SelectedClient.Edb}"/>
                    </TextBlock>

                    <!-- Contact / registration details -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14" Margin="0,0,0,22">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="VAT number"/>
                            <TextBlock Text="{Binding SelectedClient.VatNumber}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <Label Content="Country"/>
                            <TextBlock Text="{Binding SelectedClient.CountryCode}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="City / ZIP"/>
                            <TextBlock Classes="FieldValue">
                                <Run Text="{Binding SelectedClient.City}"/><Run Text=", "/><Run Text="{Binding SelectedClient.Zip}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <Label Content="Address"/>
                            <TextBlock Classes="FieldValue">
                                <Run Text="{Binding SelectedClient.Street}"/><Run Text=" "/><Run Text="{Binding SelectedClient.Number}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Invoice history for this client -->
                    <TextBlock Grid.Row="3" Text="Invoices to this client" Classes="CardHeaderStyle" Margin="0,0,0,12"/>

                    <!-- Quick stats -->
                    <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                        <Border Grid.Column="0" Classes="TotalsBox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="TOTAL INVOICES" Classes="StatLabel"/>
                                <TextBlock Text="{Binding TotalInvoiceCount}" Classes="StatValue"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="TotalsBox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="TOTAL INVOICED" Classes="StatLabel"/>
                                <TextBlock Text="{Binding TotalInvoicedAmount, StringFormat='{}{0:N2} MKD'}" Classes="StatValue"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="5" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <DataGrid ItemsSource="{Binding ClientInvoices}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Invoice No." Binding="{Binding DocNumber}" Width="*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding IssueDate}" Width="120"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding GrossAmount, StringFormat='{}{0:N2}'}" Width="130"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Classes="EmptyState" IsVisible="{Binding !HasClientInvoices}">
                                <TextBlock Text="No invoices sent to this client yet."/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>

                <!-- Empty state: nothing selected yet -->
                <StackPanel Classes="EmptyState"
                            IsVisible="{Binding SelectedClient, Converter={x:Static converters:ObjectConverters.IsNull}}">
                    <PathIcon Data="{StaticResource IconUsers}"/>
                    <TextBlock Text="Select a client to see their details and invoice history."/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>
