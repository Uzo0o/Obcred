<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:DataType="viewModels:ClientsViewModel"
             x:Class="Obcred.Views.ClientsView">

    <Grid Classes="PageRoot" Margin="24,20,24,24" ColumnDefinitions="1.1*,1.6*" ColumnSpacing="16">

        <!-- LEFT: searchable client list -->
        <Border Grid.Column="0" Classes="Card D1" Padding="0">
            <Grid RowDefinitions="Auto,Auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="16,16,16,4">
                    <Border Classes="IconAvatar">
                        <PathIcon Data="{StaticResource IconUsers}"/>
                    </Border>
                    <TextBlock Text="Клиенти" Classes="CardHeaderStyle"/>
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="16,12,16,12" ColumnSpacing="8">
                    <Panel Grid.Column="0">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Пребарај по име или ЕДБ" Padding="34,0,10,0"/>
                        <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13"
                                  Foreground="{StaticResource TextFaint}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                                  IsHitTestVisible="False"/>
                    </Panel>
                    <Button Grid.Column="1" Command="{Binding LoadCommand}" IsEnabled="{Binding IsNotBusy}"
                            Classes="SecondaryActionBtn" Padding="10,0" ToolTip.Tip="Освежи">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="14" Height="14"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,10,10" ClipToBounds="True">
                    <Panel>
                        <DataGrid ItemsSource="{Binding Clients}"
                                  SelectedItem="{Binding SelectedClient}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Име" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="ЕДБ" Binding="{Binding Edb}" Width="120"/>
                                <DataGridTextColumn Header="Град" Binding="{Binding City}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Classes="EmptyState" IsVisible="{Binding !HasClients}">
                            <PathIcon Data="{StaticResource IconUsers}"/>
                            <TextBlock Text="Сè уште нема зачувани клиенти. Тие ќе се појават овде откако ќе побарате некој на екранот за фактура."/>
                        </StackPanel>
                    </Panel>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT: selected client's details + their invoice history -->
        <Border Grid.Column="1" Classes="Card D2">
            <Panel>
                <Grid IsVisible="{Binding SelectedClient, Converter={x:Static converters:ObjectConverters.IsNotNull}}"
                      RowDefinitions="Auto,Auto,Auto,Auto,*">

                    <!-- Client identity -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,18">
                        <Border Classes="IconAvatar">
                            <PathIcon Data="{StaticResource IconUsers}"/>
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedClient.Name}" Classes="CardHeaderStyle" FontSize="17"/>
                            <TextBlock Classes="Muted">
                                <Run Text="ЕДБ"/> <Run Text="{Binding SelectedClient.Edb}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <!-- Contact / registration details -->
                    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14" Margin="0,0,0,22">
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <Label Content="ДДВ број"/>
                            <TextBlock Text="{Binding SelectedClient.VatNumber}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <Label Content="Држава"/>
                            <TextBlock Text="{Binding SelectedClient.CountryCode}" Classes="FieldValue"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <Label Content="Град / поштенски број"/>
                            <TextBlock Classes="FieldValue">
                                <Run Text="{Binding SelectedClient.City}"/><Run Text=", "/><Run Text="{Binding SelectedClient.Zip}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <Label Content="Адреса"/>
                            <TextBlock Classes="FieldValue">
                                <Run Text="{Binding SelectedClient.Street}"/><Run Text=" "/><Run Text="{Binding SelectedClient.Number}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Invoice history for this client -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
                        <Border Classes="IconAvatar" Width="30" Height="30" CornerRadius="9">
                            <PathIcon Data="{StaticResource IconHistory}" Width="14" Height="14"/>
                        </Border>
                        <TextBlock Text="Фактури до овој клиент" Classes="CardHeaderStyle" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick stats -->
                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,12">
                        <Border Grid.Column="0" Classes="TotalsBox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ВКУПНО ФАКТУРИ" Classes="StatLabel"/>
                                <TextBlock Text="{Binding TotalInvoiceCount}" Classes="StatValue"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="TotalsBox">
                            <StackPanel Spacing="3">
                                <TextBlock Text="ВКУПНО ФАКТУРИРАНО" Classes="StatLabel"/>
                                <TextBlock Text="{Binding TotalInvoicedAmount, StringFormat='{}{0:N2} MKD'}" Classes="StatValue"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="4" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" ClipToBounds="True">
                        <Panel>
                            <DataGrid ItemsSource="{Binding ClientInvoices}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Бр. на фактура" Binding="{Binding DocNumber}" Width="*"/>
                                    <DataGridTextColumn Header="Датум" Binding="{Binding IssueDate}" Width="120"/>
                                    <DataGridTextColumn Header="Вкупно" Binding="{Binding GrossAmount, StringFormat='{}{0:N2}'}" Width="130"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Classes="EmptyState" IsVisible="{Binding !HasClientInvoices}">
                                <TextBlock Text="Сè уште нема испратени фактури до овој клиент."/>
                            </StackPanel>
                        </Panel>
                    </Border>
                </Grid>

                <!-- Empty state: nothing selected yet -->
                <StackPanel Classes="EmptyState"
                            IsVisible="{Binding SelectedClient, Converter={x:Static converters:ObjectConverters.IsNull}}">
                    <PathIcon Data="{StaticResource IconUsers}"/>
                    <TextBlock Text="Изберете клиент за да ги видите неговите детали и историјата на фактури."/>
                </StackPanel>
            </Panel>
        </Border>
    </Grid>
</UserControl>