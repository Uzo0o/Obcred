<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:local="using:Obcred.Converters"
             xmlns:models="using:Obcred.Models"
             x:DataType="viewModels:PurchaseInvoicesViewModel"
             x:Class="Obcred.Views.PurchaseInvoicesView">

    <Grid Classes="PageRoot" Margin="28,24,28,28" RowDefinitions="Auto,Auto,*">
        <Grid.RenderTransform>
            <TranslateTransform/>
        </Grid.RenderTransform>

        <!-- TITLE -->
        <TextBlock Grid.Row="0" Text="Received Invoices" Classes="PageTitleStyle"/>

        <!-- SYNC TOOLBAR -->
        <Border Grid.Row="1" Classes="Card" Padding="16,14" Margin="0,0,0,20">
            <Grid ColumnDefinitions="Auto,150,Auto,150,Auto,*">
                <TextBlock Grid.Column="0" Text="From" Classes="TotalLabel" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding DateFrom}"/>

                <TextBlock Grid.Column="2" Text="To" Classes="TotalLabel" VerticalAlignment="Center" Margin="16,0,10,0"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding DateTo}"/>

                <Button Grid.Column="4" Command="{Binding SyncFromUjpCommand}" IsEnabled="{Binding IsNotBusy}"
                        Classes="PrimaryActionBtn" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconInbox}" Width="15" Height="15" VerticalAlignment="Center"/>
                        <TextBlock Text="Sync from UJP" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" Foreground="{StaticResource TextMuted}"
                           FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- LIST + DETAIL -->
        <Grid Grid.Row="2" ColumnDefinitions="1.3*,1*">

            <!-- LEFT: list of incoming invoices, each with a Paid/Unpaid badge -->
            <Border Grid.Column="0" Classes="Card" Padding="10" Margin="0,0,16,0">
                <Grid>
                    <ListBox ItemsSource="{Binding Invoices}"
                             SelectedItem="{Binding SelectedInvoice}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentLight}"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PurchaseInvoiceRecord">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding SellerName}" FontWeight="SemiBold" FontSize="13.5"
                                                       Foreground="{StaticResource BrandText}"/>
                                        </StackPanel>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding DocNumber}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding DocDate}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                        <TextBlock Text="{Binding GrossAmount, StringFormat='{}{0:N2} MKD'}"
                                                   FontWeight="Bold" FontSize="13.5" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource BrandText}"/>
                                        <Border CornerRadius="6" Padding="8,2" HorizontalAlignment="Right"
                                                Background="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.BackgroundConverter}}">
                                            <TextBlock Text="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.LabelConverter}}"
                                                       FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.ForegroundConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                IsVisible="{Binding !HasInvoices}">
                        <PathIcon Data="{StaticResource IconInbox}" Width="32" Height="32" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="No invoices cached yet. Pick a date range above and sync from UJP."
                                   Foreground="#94A3B8" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Width="220"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: full detail of the selected invoice -->
            <Border Grid.Column="1" Classes="Card">
                <Panel>
                <ScrollViewer IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Border Classes="CardHeaderAccent"/>
                            <TextBlock Text="{Binding SelectedInvoice.SellerName}" Classes="CardHeaderStyle" Margin="0" FontSize="17"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding SelectedInvoice.DocNumber, StringFormat='Invoice No.: {0}'}"
                               Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="15,0,0,18"/>

                    <!-- Paid / Unpaid toggle -->
                    <Button Command="{Binding TogglePaidCommand}" CommandParameter="{Binding SelectedInvoice}"
                            HorizontalAlignment="Left" Margin="0,0,0,20"
                            Classes="SecondaryActionBtn">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding SelectedInvoice.IsPaid, Converter={x:Static local:PaidBadgeConverters.DotColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding SelectedInvoice.IsPaid, Converter={x:Static local:PaidBadgeConverters.ToggleLabelConverter}}"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <!-- Status + dates -->
                    <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,18">
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Label Content="Document Status"/>
                            <TextBlock Text="{Binding SelectedInvoice.StatusName}" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" FontSize="13.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <Label Content="Doc. Date"/>
                            <TextBlock Text="{Binding SelectedInvoice.DocDate}" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" FontSize="13.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="Delivery Date"/>
                            <TextBlock Text="{Binding SelectedInvoice.DocDeliveryDate}" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" FontSize="13.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- Seller -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Classes="CardHeaderAccent"/>
                        <TextBlock Text="Seller" Classes="CardHeaderStyle" Margin="0" FontSize="14"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,18">
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <Label Content="EDB (Tax No.)"/>
                            <TextBlock Text="{Binding SelectedInvoice.SellerTin}" FontWeight="SemiBold" Foreground="{StaticResource BrandText}" FontSize="13.5"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label Content="Address"/>
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrandText}" FontSize="13.5" TextWrapping="Wrap">
                                <Run Text="{Binding SelectedInvoice.SellerStreet}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedInvoice.SellerNumber}"/>
                                <Run Text=", "/>
                                <Run Text="{Binding SelectedInvoice.SellerCity}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Amounts -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Classes="CardHeaderAccent"/>
                        <TextBlock Text="Amounts" Classes="CardHeaderStyle" Margin="0" FontSize="14"/>
                    </StackPanel>
                    <Border Classes="TotalsBox">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Net Amount:" Classes="TotalLabel"/>
                                <TextBlock Text="{Binding SelectedInvoice.NetAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="VAT Amount:" Classes="TotalLabel"/>
                                <TextBlock Text="{Binding SelectedInvoice.VatAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="Advance Paid:" Classes="TotalLabel"/>
                                <TextBlock Text="{Binding SelectedInvoice.AvansAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderLight}"/>
                            <Grid>
                                <TextBlock Text="Final Amount Due:" Classes="TotalFinalLabel" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedInvoice.FinalAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalFinalValue" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNull}}">
                    <PathIcon Data="{StaticResource IconInbox}" Width="32" Height="32" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select an invoice to see its full details." Foreground="#94A3B8" FontSize="13" TextAlignment="Center"/>
                </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
