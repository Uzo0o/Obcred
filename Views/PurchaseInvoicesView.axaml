<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:local="using:Obcred.Converters"
             xmlns:models="using:Obcred.Models"
             x:DataType="viewModels:PurchaseInvoicesViewModel"
             x:Class="Obcred.Views.PurchaseInvoicesView">

    <Grid Classes="PageRoot" Margin="24,20,24,24" RowDefinitions="Auto,*" RowSpacing="16">

        <!-- SYNC TOOLBAR -->
        <Border Grid.Row="0" Classes="Card D1" Padding="16,12">
            <Grid ColumnDefinitions="Auto,150,Auto,150,Auto,*" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Од" Classes="Muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <CalendarDatePicker Grid.Column="1" SelectedDate="{Binding DateFrom, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>

                <TextBlock Grid.Column="2" Text="До" Classes="Muted" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <CalendarDatePicker Grid.Column="3" SelectedDate="{Binding DateTo, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>

                <Button Grid.Column="4" Command="{Binding SyncFromUjpCommand}" IsEnabled="{Binding IsNotBusy}"
                        Classes="PrimaryActionBtn" Margin="14,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconInbox}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Синхронизирај од УЈП" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="5" Text="{Binding StatusMessage}" Classes="StatusNote"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- LIST + DETAIL -->
        <Grid Grid.Row="1" ColumnDefinitions="1.3*,1*" ColumnSpacing="16">

            <!-- LEFT: list of incoming invoices, each with a Paid/Unpaid badge -->
            <Border Grid.Column="0" Classes="Card D2" Padding="8">
                <Panel>
                    <ListBox ItemsSource="{Binding Invoices}"
                             SelectedItem="{Binding SelectedInvoice}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,0,0,2"/>
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource AccentLight}"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:PurchaseInvoiceRecord">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SellerName}" FontWeight="Medium" FontSize="13"
                                                   Foreground="{StaticResource BrandText}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}">
                                            <Run Text="{Binding DocNumber}"/><Run Text="  ·  "/><Run Text="{Binding DocDate}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GrossAmount, StringFormat='{}{0:N2} MKD'}"
                                                   FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"
                                                   Foreground="{StaticResource BrandText}"/>
                                        <Border CornerRadius="4" Padding="7,2" HorizontalAlignment="Right"
                                                Background="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.BackgroundConverter}}">
                                            <TextBlock Text="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.LabelConverter}}"
                                                       FontSize="10" FontWeight="SemiBold" LetterSpacing="0.4"
                                                       Foreground="{Binding IsPaid, Converter={x:Static local:PaidBadgeConverters.ForegroundConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Classes="EmptyState" IsVisible="{Binding !HasInvoices}">
                        <PathIcon Data="{StaticResource IconInbox}"/>
                        <TextBlock Text="Сè уште нема ништо тука. Изберете период погоре и синхронизирајте од УЈП."/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- RIGHT: full detail of the selected invoice -->
            <Border Grid.Column="1" Classes="Card D3">
                <Panel>
                    <ScrollViewer IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
                        <StackPanel>

                            <TextBlock Text="{Binding SelectedInvoice.SellerName}" Classes="CardHeaderStyle" FontSize="17" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedInvoice.DocNumber, StringFormat='Фактура {0}'}" Classes="Muted" Margin="0,2,0,16"/>

                            <!-- Paid / Unpaid toggle -->
                            <Button Command="{Binding TogglePaidCommand}" CommandParameter="{Binding SelectedInvoice}"
                                    HorizontalAlignment="Left" Margin="0,0,0,20"
                                    Classes="SecondaryActionBtn">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding SelectedInvoice.IsPaid, Converter={x:Static local:PaidBadgeConverters.DotColorConverter}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SelectedInvoice.IsPaid, Converter={x:Static local:PaidBadgeConverters.ToggleLabelConverter}}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Status + dates -->
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,0,0,20">
                                <StackPanel Grid.Column="0">
                                    <Label Content="Статус"/>
                                    <TextBlock Text="{Binding SelectedInvoice.StatusName}" Classes="FieldValue"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="Датум на документ"/>
                                    <TextBlock Text="{Binding SelectedInvoice.DocDate}" Classes="FieldValue"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <Label Content="Датум на испорака"/>
                                    <TextBlock Text="{Binding SelectedInvoice.DocDeliveryDate}" Classes="FieldValue"/>
                                </StackPanel>
                            </Grid>

                            <!-- Seller -->
                            <TextBlock Text="ПРОДАВАЧ" Classes="SectionLabel" Margin="0,0,0,10"/>
                            <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="12" Margin="0,0,0,20">
                                <StackPanel Grid.Column="0">
                                    <Label Content="ЕДБ (даночен број)"/>
                                    <TextBlock Text="{Binding SelectedInvoice.SellerTin}" Classes="FieldValue"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="Адреса"/>
                                    <TextBlock Classes="FieldValue">
                                        <Run Text="{Binding SelectedInvoice.SellerStreet}"/><Run Text=" "/><Run Text="{Binding SelectedInvoice.SellerNumber}"/><Run Text=", "/><Run Text="{Binding SelectedInvoice.SellerCity}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- Amounts -->
                            <TextBlock Text="ИЗНОСИ" Classes="SectionLabel" Margin="0,0,0,10"/>
                            <Border Classes="TotalsBox" Margin="0,0,0,12">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <TextBlock Text="Нето износ" Classes="TotalLabel"/>
                                        <TextBlock Text="{Binding SelectedInvoice.NetAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="ДДВ" Classes="TotalLabel"/>
                                        <TextBlock Text="{Binding SelectedInvoice.VatAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Платен аванс" Classes="TotalLabel"/>
                                        <TextBlock Text="{Binding SelectedInvoice.AvansAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Classes="TotalHighlight">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ИЗНОС ЗА ПЛАЌАЊЕ" Classes="TotalHighlightLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedInvoice.FinalAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalHighlightValue"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Classes="EmptyState"
                                IsVisible="{Binding SelectedInvoice, Converter={x:Static converters:ObjectConverters.IsNull}}">
                        <PathIcon Data="{StaticResource IconInbox}"/>
                        <TextBlock Text="Изберете фактура за да ги видите целосните детали."/>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>