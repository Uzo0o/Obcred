<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Obcred.Views.LoginWindow"
        Title="Sign in — Obcred"
        Icon="/logo64.ico"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceWhite}"
        xmlns:vm="using:Obcred.ViewModels"
        x:DataType="vm:LoginViewModel">

    <StackPanel Margin="36,36,36,32" Spacing="0">

        <Image Source="avares://Obcred/Assets/Logo.png" Width="48" Height="48"
               HorizontalAlignment="Center" Margin="0,0,0,18"/>

        <TextBlock Text="Welcome to Obcred" FontSize="19" FontWeight="SemiBold" LetterSpacing="-0.2"
                   Foreground="{StaticResource BrandText}" HorizontalAlignment="Center"/>
        <TextBlock Text="Sign in with your Google account to continue."
                   Classes="Muted" FontSize="13"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="300" Margin="0,6,0,26"/>

        <!-- Idle state: just the Google button -->
        <Button Content="Continue with Google"
                Command="{Binding LoginCommand}"
                Classes="PrimaryActionBtn"
                Height="40"
                HorizontalAlignment="Stretch"
                IsVisible="{Binding !IsBusy}"/>

        <!-- Busy state: waiting on the browser -->
        <StackPanel IsVisible="{Binding IsBusy}" Spacing="12">
            <ProgressBar IsIndeterminate="True" Height="3" CornerRadius="2"
                         Foreground="{StaticResource BrandAccent}" Background="{StaticResource BorderLight}"/>
            <TextBlock Text="{Binding StatusMessage}" Classes="Muted" FontSize="13"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock Text="A browser window has opened — finish signing in there."
                       Foreground="{StaticResource TextFaint}" FontSize="12"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button Content="Cancel" Command="{Binding CancelLoginCommand}"
                    Classes="SecondaryActionBtn" HorizontalAlignment="Center" Width="120"/>
        </StackPanel>

        <!-- Error banner -->
        <Border Classes="BannerDanger" IsVisible="{Binding HasError}" Margin="0,14,0,0" Padding="12,8" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrandDanger}"
                       FontSize="12.5" FontWeight="Normal" LetterSpacing="0" TextWrapping="Wrap"/>
        </Border>

    </StackPanel>
</Window>
