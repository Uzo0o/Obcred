<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:local="using:Obcred.Converters"
             x:DataType="viewModels:PdfSettingsViewModel"
             x:Class="Obcred.Views.PdfSettingsView">

    <Grid Classes="PageRoot" Margin="24,20,24,24" ColumnDefinitions="1*,1.3*" ColumnSpacing="16">

        <!-- LEFT: template picker + logo + save -->
        <StackPanel Grid.Column="0" Spacing="16">

            <Border Classes="Card">
                <StackPanel>
                    <TextBlock Text="Layout" Classes="CardHeaderStyle" Margin="0,0,0,12"/>

                    <RadioButton Classes="TemplateCard" GroupName="PdfTemplate"
                                 Command="{Binding SelectTemplateCommand}" CommandParameter="Classic"
                                 IsChecked="{Binding SelectedTemplateId, Converter={x:Static local:StringEqualsConverter.Instance}, ConverterParameter=Classic}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Classic" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource BrandText}"/>
                            <TextBlock Text="Bordered seller/buyer boxes and a ruled table. Traditional and safe."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="TemplateCard" GroupName="PdfTemplate"
                                 Command="{Binding SelectTemplateCommand}" CommandParameter="Modern"
                                 IsChecked="{Binding SelectedTemplateId, Converter={x:Static local:StringEqualsConverter.Instance}, ConverterParameter=Modern}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Modern" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource BrandText}"/>
                            <TextBlock Text="Accent header band with your logo, shaded table rows, a stronger totals block."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="TemplateCard" GroupName="PdfTemplate" Margin="0"
                                 Command="{Binding SelectTemplateCommand}" CommandParameter="Minimal"
                                 IsChecked="{Binding SelectedTemplateId, Converter={x:Static local:StringEqualsConverter.Instance}, ConverterParameter=Minimal}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Minimal" FontWeight="SemiBold" FontSize="13.5" Foreground="{StaticResource BrandText}"/>
                            <TextBlock Text="No borders or shading — typography, whitespace and thin dividers."
                                       FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <Border Classes="Card">
                <StackPanel>
                    <TextBlock Text="Company logo" Classes="CardHeaderStyle" Margin="0,0,0,12"/>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8"
                                Background="{StaticResource SurfaceSubtle}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                ClipToBounds="True">
                            <Panel>
                                <Image Source="{Binding LogoPreview}" Stretch="Uniform" Margin="6"
                                       IsVisible="{Binding HasLogo}"/>
                                <PathIcon Data="{StaticResource IconLayout}" Width="18" Height="18" Foreground="{StaticResource BorderStrong}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsVisible="{Binding !HasLogo}"/>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="PNG or JPEG. Placed in the header of the invoice, position depends on the layout."
                                       Classes="Muted" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding BrowseLogoCommand}" Classes="SecondaryActionBtn" Content="Upload logo"/>
                                <Button Command="{Binding RemoveLogoCommand}" Classes="IconGhostBtn" IsVisible="{Binding HasLogo}"
                                        ToolTip.Tip="Remove logo" Padding="8" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Close}" Width="11" Height="11"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <Button Command="{Binding SaveCommand}" Classes="PrimaryActionBtn" HorizontalAlignment="Stretch" Content="Save template"/>
                <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote" TextAlignment="Center"
                           IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </StackPanel>

        <!-- RIGHT: live preview -->
        <Border Grid.Column="1" Classes="Card" Padding="0">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="Preview" Classes="CardHeaderStyle" Margin="20,16,20,14"/>

                <Border Grid.Row="1" Background="{StaticResource BrandBackground}" CornerRadius="0,0,10,10"
                        BorderBrush="{StaticResource BorderLight}" BorderThickness="0,1,0,0" Padding="20">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                                BoxShadow="0 6 18 -8 #33000000" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Image Source="{Binding PdfPreview}" Stretch="Uniform" MaxWidth="480"/>
                        </Border>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
