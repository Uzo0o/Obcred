<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Obcred.ViewModels"
             xmlns:sys="using:System"
             xmlns:col="using:System.Collections.Generic"
             xmlns:models="using:Obcred.Models"
             xmlns:local="using:Obcred.Converters"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:DataType="viewModels:InvoiceViewModel"
             x:Class="Obcred.Views.InvoiceEntryView"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels">

    <ScrollViewer>
        <Grid Classes="PageRoot" Margin="24,20,24,24" RowDefinitions="Auto,Auto">

            <!-- ================= CARD 1: DETAILS + BUYER + ACTIONS ================= -->
            <Border Grid.Row="0" Classes="Card" Margin="0,0,0,16">
                <Grid ColumnDefinitions="1.1*,1.6*,Auto">

                    <!-- 1. DOCUMENT -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" Spacing="0">
                        <TextBlock Text="Document" Classes="CardHeaderStyle" Margin="0,0,0,14"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="12">

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Label Content="Invoice No."/>
                                <TextBox Text="{Binding InvoiceNumber}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <Label Content="Document type"/>
                                <!-- Plain string items so the selection binds straight to the
                                     view model's SelectedDocumentType (and the default shows). -->
                                <ComboBox SelectedItem="{Binding SelectedDocumentType}">
                                    <sys:String>100</sys:String>
                                    <sys:String>380</sys:String>
                                    <sys:String>383</sys:String>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <Label Content="Issue date"/>
                                <CalendarDatePicker SelectedDate="{Binding InvoiceDate, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <Label Content="Turnover date"/>
                                <CalendarDatePicker SelectedDate="{Binding TurnoverDate, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 2. BUYER -->
                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Text="Buyer" Classes="CardHeaderStyle" Margin="0,0,0,14"/>
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="2*,1*" ColumnSpacing="12" RowSpacing="12">

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Label Content="Saved client"/>
                                <ComboBox ItemsSource="{Binding AllClients}" SelectedItem="{Binding SelectedClient}"
                                          DisplayMemberBinding="{Binding Name}" PlaceholderText="Choose a client…"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <Label Content="EDB (tax no.)"/>
                                <TextBox Text="{Binding BuyerEdb}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <Label Content="Official name"/>
                                <TextBox Text="{Binding BuyerName}" IsReadOnly="True" Classes="ReadOnlyField"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <Label Content="City"/>
                                <TextBox Text="{Binding SelectedClient.City}" IsReadOnly="True" Classes="ReadOnlyField"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- 3. ACTIONS — equal widths, primary last -->
                    <StackPanel Grid.Column="2" Width="176" Spacing="8" VerticalAlignment="Top" Margin="0,29,0,0">
                        <Button Command="{Binding LookupCompanyCommand}" IsEnabled="{Binding IsNotBusy}"
                                Classes="SecondaryActionBtn" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Look up in UJP" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SavePdfCommand}" IsEnabled="{Binding IsNotBusy}"
                                Classes="SecondaryActionBtn" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSave}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Save PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding SubmitInvoiceCommand}" IsEnabled="{Binding IsNotBusy}"
                                Classes="PrimaryActionBtn" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconSend}" Width="15" Height="15" VerticalAlignment="Center"/>
                                <TextBlock Text="Submit invoice" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar IsIndeterminate="True" Height="3" CornerRadius="2"
                                     IsVisible="{Binding IsBusy}" Foreground="{StaticResource BrandAccent}"
                                     Background="{StaticResource BorderLight}"/>

                        <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CARD 2: LINE ITEMS ================= -->
            <Border Grid.Row="1" Classes="Card">
                <Grid RowDefinitions="Auto,Auto,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <TextBlock Grid.Column="0" Text="Line items" Classes="CardHeaderStyle"/>
                        <Button Grid.Column="1" Command="{Binding AddBlankItemCommand}" Classes="GhostLinkBtn">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Add line" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,0,16" MinHeight="150">
                        <Panel>
                            <DataGrid ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" BorderThickness="0"
                                      CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Item" Binding="{Binding Desc}" Width="*"/>

                                    <DataGridTemplateColumn Header="VAT (DDV)" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding TaxIndicator}"
                                                          ItemsSource="{x:Static models:VatRates.DisplayNames}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          MinHeight="30"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Margin="0,4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="90"/>
                                    <DataGridTextColumn Header="Unit price" Binding="{Binding UnitPrice}" Width="130"/>
                                    <DataGridTextColumn Header="Row total" Binding="{Binding RowGrossTotal, StringFormat='{}{0:N2}'}" IsReadOnly="True" Width="140"/>

                                    <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Classes="IconGhostBtn"
                                                        Command="{Binding $parent[DataGrid].((viewModels:InvoiceViewModel)DataContext).RemoveItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip.Tip="Remove this line">
                                                    <PathIcon Data="{StaticResource Close}" Width="11" Height="11"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Classes="EmptyState" Margin="0,36,0,0"
                                        IsVisible="{Binding InvoiceItems.Count, Converter={x:Static local:IsZeroConverter.Instance}}">
                                <TextBlock Text="No line items yet. Click “Add line” to start the invoice."/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- TOTALS -->
                    <Border Grid.Row="2" HorizontalAlignment="Right" Width="300" Classes="TotalsBox">
                        <StackPanel Spacing="10">
                            <Grid>
                                <TextBlock Text="Subtotal" Classes="TotalLabel"/>
                                <TextBlock Text="{Binding NetAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid>
                                <TextBlock Text="VAT (DDV)" Classes="TotalLabel"/>
                                <TextBlock Text="{Binding VatAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{StaticResource BorderLight}" Margin="0,2"/>
                            <Grid>
                                <TextBlock Text="Total" Classes="TotalFinalLabel" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding GrossAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalFinalValue" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
