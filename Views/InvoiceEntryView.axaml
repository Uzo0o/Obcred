<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Obcred.ViewModels"
             xmlns:sys="using:System"
             xmlns:col="using:System.Collections.Generic"
             xmlns:models="using:Obcred.Models"
             xmlns:local="using:Obcred.Converters"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:DataType="viewModels:InvoiceViewModel"
             x:Class="Obcred.Views.InvoiceEntryView"
             xmlns:viewModels="clr-namespace:Obcred.ViewModels">

    <ScrollViewer>
        <Grid Classes="PageRoot" Margin="24,18,24,20" RowDefinitions="Auto,Auto">

            <!-- ================= ROW 1: BUYER + DOCUMENT (separate cards) ================= -->
            <Grid Grid.Row="0" ColumnDefinitions="1.15*,1*" ColumnSpacing="16" Margin="0,0,0,14">

                <!-- BUYER -->
                <Border Grid.Column="0" Classes="Card D1">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="IconAvatar">
                                <PathIcon Data="{StaticResource IconUsers}"/>
                            </Border>
                            <TextBlock Text="Купувач" Classes="CardHeaderStyle"/>
                        </StackPanel>

                        <StackPanel>
                            <Label Content="Зачуван клиент"/>
                            <ComboBox ItemsSource="{Binding AllClients}" SelectedItem="{Binding SelectedClient}"
                                      DisplayMemberBinding="{Binding Name}" PlaceholderText="Изберете клиент…"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0">
                                <Label Content="ЕДБ (даночен број)"/>
                                <TextBox Text="{Binding BuyerEdb}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding LookupCompanyCommand}" IsEnabled="{Binding IsNotBusy}"
                                    Classes="SecondaryActionBtn" Height="36" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconSearch}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Побарај во УЈП" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <Label Content="Официјален назив"/>
                                <TextBox Text="{Binding BuyerName}" IsReadOnly="True" Classes="ReadOnlyField"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Град"/>
                                <TextBox Text="{Binding SelectedClient.City}" IsReadOnly="True" Classes="ReadOnlyField"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DOCUMENT -->
                <Border Grid.Column="1" Classes="Card D2">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="IconAvatar">
                                <PathIcon Data="{StaticResource Document}"/>
                            </Border>
                            <TextBlock Text="Документ" Classes="CardHeaderStyle"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <Label Content="Тип на документ"/>
                                <!-- Items are the real UJP DocumentType objects (code + display
                                     name); SelectedItem binds straight to the DocumentType so
                                     the payload can read .Code/.Name off whichever is picked. -->
                                <ComboBox ItemsSource="{Binding DocumentTypeOptions}"
                                          SelectedItem="{Binding SelectedDocumentType}"
                                          DisplayMemberBinding="{Binding Name}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Бр. на фактура"/>
                                <TextBox Text="{Binding InvoiceNumber}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Grid.Column="0">
                                <Label Content="Датум на издавање"/>
                                <CalendarDatePicker SelectedDate="{Binding InvoiceDate, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Датум на промет"/>
                                <CalendarDatePicker SelectedDate="{Binding TurnoverDate, Converter={x:Static local:DateTimeOffsetToDateTimeConverter.Instance}}"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Command="{Binding SavePdfCommand}" IsEnabled="{Binding IsNotBusy}"
                                    Classes="SecondaryActionBtn" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconSave}" Width="13" Height="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Зачувај PDF" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SubmitInvoiceCommand}" IsEnabled="{Binding IsNotBusy}"
                                    Classes="PrimaryActionBtn" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource IconSend}" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Испрати фактура" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ProgressBar IsIndeterminate="True" Height="3" CornerRadius="2"
                                     IsVisible="{Binding IsBusy}" Foreground="{StaticResource BrandAccent}"
                                     Background="{StaticResource BorderLight}"/>

                        <TextBlock Text="{Binding StatusMessage}" Classes="StatusNote"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ================= ROW 2: LINE ITEMS ================= -->
            <Border Grid.Row="1" Classes="Card D3">
                <Grid RowDefinitions="Auto,Auto,Auto">

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                            <Border Classes="IconAvatar">
                                <PathIcon Data="{StaticResource IconLayout}"/>
                            </Border>
                            <TextBlock Text="Ставки" Classes="CardHeaderStyle"/>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding AddBlankItemCommand}" Classes="GhostLinkBtn">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconPlus}" Width="11" Height="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Додади ставка" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1"
                            ClipToBounds="True" Margin="0,0,0,12" MinHeight="120">
                        <Panel>
                            <DataGrid ItemsSource="{Binding InvoiceItems}" AutoGenerateColumns="False" BorderThickness="0"
                                      CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ставка" Binding="{Binding Desc}" Width="*"/>

                                    <DataGridTemplateColumn Header="ДДВ" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedItem="{Binding TaxIndicator}"
                                                          ItemsSource="{x:Static models:VatRates.DisplayNames}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          MinHeight="30"
                                                          Background="Transparent"
                                                          BorderThickness="0"
                                                          Margin="0,4"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Кол." Binding="{Binding Qty}" Width="90"/>
                                    <DataGridTextColumn Header="Ед. цена" Binding="{Binding UnitPrice}" Width="130"/>
                                    <DataGridTextColumn Header="Вкупно за ред" Binding="{Binding RowGrossTotal, StringFormat='{}{0:N2}'}" IsReadOnly="True" Width="140"/>

                                    <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Classes="IconGhostBtn"
                                                        Command="{Binding $parent[DataGrid].((viewModels:InvoiceViewModel)DataContext).RemoveItemCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        ToolTip.Tip="Отстрани ја оваа ставка">
                                                    <PathIcon Data="{StaticResource Close}" Width="11" Height="11"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Classes="EmptyState" Margin="0,36,0,0"
                                        IsVisible="{Binding InvoiceItems.Count, Converter={x:Static local:IsZeroConverter.Instance}}">
                                <TextBlock Text="Сè уште нема ставки. Кликнете „Додади ставка“ за да ја започнете фактурата."/>
                            </StackPanel>
                        </Panel>
                    </Border>

                    <!-- TOTALS -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Right" Width="320" Spacing="12">
                        <Border Classes="TotalsBox">
                            <StackPanel Spacing="10">
                                <Grid>
                                    <TextBlock Text="Меѓузбир" Classes="TotalLabel"/>
                                    <TextBlock Text="{Binding NetAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="ДДВ" Classes="TotalLabel"/>
                                    <TextBlock Text="{Binding VatAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalValue" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Classes="TotalHighlight">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="ВКУПНО" Classes="TotalHighlightLabel" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GrossAmount, StringFormat='{}{0:N2} MKD'}" Classes="TotalHighlightValue"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>