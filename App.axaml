<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Obcred.App"
             xmlns:local="using:Obcred"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <!-- 1. DEFINE RESOURCES FIRST -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Obcred/Resources/Icons.axaml"/>
                <ResourceInclude Source="avares://Obcred/Resources/WindowChrome.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ===================== BRAND COLORS =====================
                 A single blue accent carried through as a gradient (buttons, active nav,
                 the invoice grand total) rather than a flat fill, plus cool navy ink and
                 greys for everything else. The accent is reserved for the primary action,
                 the active nav item, links and the final total. -->
            <SolidColorBrush x:Key="BrandAccent" Color="#3D74E8"/>
            <SolidColorBrush x:Key="BrandAccentHover" Color="#2E5FD1"/>
            <SolidColorBrush x:Key="BrandAccentPressed" Color="#2450B8"/>
            <SolidColorBrush x:Key="BrandBackground" Color="#F3F6FB"/>
            <SolidColorBrush x:Key="BrandText" Color="#0E1B36"/>
            <SolidColorBrush x:Key="BrandSuccess" Color="#0B7A5C"/>
            <SolidColorBrush x:Key="BrandDanger" Color="#D93025"/>
            <SolidColorBrush x:Key="SurfaceWhite" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BorderLight" Color="#E3E9F3"/>
            <SolidColorBrush x:Key="BorderStrong" Color="#D6DFEE"/>
            <SolidColorBrush x:Key="TextMuted" Color="#5A6782"/>
            <SolidColorBrush x:Key="TextFaint" Color="#8A96AD"/>

            <!-- Derived / supporting shades -->
            <SolidColorBrush x:Key="AccentLight" Color="#EAF1FF"/>
            <SolidColorBrush x:Key="AccentSoft" Color="#D3E3FF"/>
            <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="InputBackgroundDisabled" Color="#F3F5F8"/>
            <SolidColorBrush x:Key="SurfaceSubtle" Color="#F5F8FD"/>
            <SolidColorBrush x:Key="SidebarText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SidebarTextMuted" Color="#9DB0D3"/>
            <SolidColorBrush x:Key="SidebarHoverBackground" Color="#172C57"/>
            <SolidColorBrush x:Key="SidebarActiveAccentText" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="SidebarDivider" Color="#26385F"/>
            <SolidColorBrush x:Key="DangerSoft" Color="#FDE8E7"/>
            <SolidColorBrush x:Key="SuccessSoft" Color="#E3F7EF"/>
            <SolidColorBrush x:Key="LiveDot" Color="#22C58C"/>

            <!-- Gradients: the accent carried as a diagonal blue sweep instead of a flat
                 fill, used for the primary button, the active nav pill and the grand total. -->
            <LinearGradientBrush x:Key="BrandAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#5B93F5"/>
                <GradientStop Offset="1" Color="#2E5FD1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TotalHighlightGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#4C86F2"/>
                <GradientStop Offset="1" Color="#2450B8"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="IconAvatarGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#EAF1FF"/>
                <GradientStop Offset="1" Color="#DCE9FF"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TotalsBoxGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#F5F9FF"/>
                <GradientStop Offset="1" Color="#EAF1FF"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DataGridHeaderGradient" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0" Color="#F5F8FD"/>
                <GradientStop Offset="1" Color="#EFF3FA"/>
            </LinearGradientBrush>

            <!-- Sidebar: a deep, low-contrast navy sweep instead of a flat panel. -->
            <LinearGradientBrush x:Key="SidebarBackground" StartPoint="0%,0%" EndPoint="30%,100%">
                <GradientStop Offset="0" Color="#132A56"/>
                <GradientStop Offset="1" Color="#0A1630"/>
            </LinearGradientBrush>

            <!-- Main content backdrop: a faint accent glow in the top-right corner over
                 the flat page background, instead of a flat fill. -->
            <RadialGradientBrush x:Key="ContentBackdrop" Center="100%,0%" GradientOrigin="100%,0%" RadiusX="70%" RadiusY="70%">
                <GradientStop Offset="0" Color="#143D74E8"/>
                <GradientStop Offset="1" Color="#F3F6FB"/>
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="SidebarActiveBackground" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="#5B93F5"/>
                <GradientStop Offset="1" Color="#2E5FD1"/>
            </LinearGradientBrush>

            <!-- Montserrat first: it has full, properly-weighted Cyrillic glyphs. Poppins'
                 Cyrillic coverage is much thinner/lighter than its Latin glyphs at the same
                 weight, which made muted Macedonian labels barely legible — Poppins stays as
                 the fallback for any Latin-only text a future feature might need. -->
            <FontFamily x:Key="AppFont">avares://Obcred/Assets/Fonts#Montserrat,avares://Obcred/Assets/Fonts#Poppins</FontFamily>
            <FontFamily x:Key="NumFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <!-- 2. USE STYLES SECOND -->
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Unifies the Fluent theme's internal "system accent" (used by the Calendar
                     flyout's selected day, ComboBox's selected/hover item, focus rings, etc.)
                     with our brand accent, instead of the generic Fluent blue. -->
                <ColorPaletteResources x:Key="Light" Accent="#3D74E8"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <!-- ========================================== -->
        <!-- 0. GLOBAL DEFAULTS                          -->
        <!-- ========================================== -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>
        <Style Selector="Button, TextBox, ComboBox, ComboBoxItem, DatePicker, CalendarDatePicker, CheckBox, RadioButton, Label, ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        </Style>

        <!-- Tabular-figure numbers: invoice totals, EDB, amounts. Keeps digits aligned
             in columns instead of the proportional body font's variable widths. -->
        <Style Selector="TextBlock.Num">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        </Style>

        <!-- ========================================== -->
        <!-- 1. TYPOGRAPHY                                -->
        <!-- Scale: 22 page / 15 card header / 13 body / 12 label / 11 caption -->
        <!-- ========================================== -->
        <Style Selector="TextBlock.PageTitleStyle">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="-0.2"/>
        </Style>

        <Style Selector="TextBlock.CardHeaderStyle">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Small uppercase label for sub-sections inside a card -->
        <Style Selector="TextBlock.SectionLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
        </Style>

        <Style Selector="TextBlock.Muted">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>

        <!-- Read-only value shown under a Label (client details, invoice details) -->
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Status / feedback line. Neutral on purpose: the same string carries both
             successes and errors, so a fixed green or red would lie half the time. -->
        <Style Selector="TextBlock.StatusNote">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <!-- Kept for older views; no longer used as a header decoration. -->
        <Style Selector="Border.CardHeaderAccent">
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <!-- Small rounded gradient badge that sits beside a CardHeaderStyle title,
             holding a 18x18 PathIcon (see IconAvatar > PathIcon below). -->
        <Style Selector="Border.IconAvatar">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource IconAvatarGradient}"/>
        </Style>
        <Style Selector="Border.IconAvatar > PathIcon">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ========================================== -->
        <!-- 2. CARDS                                     -->
        <!-- White surface, soft two-layer elevation shadow, no hover (a card is a -->
        <!-- surface, not a button). -->
        <!-- ========================================== -->
        <Style Selector="Border.Card">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #14102A4F, 0 10 24 0 #0F102A4F"/>
        </Style>

        <!-- Centered placeholder shown when a list or grid has nothing in it -->
        <Style Selector="StackPanel.EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Spacing" Value="8"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="StackPanel.EmptyState > PathIcon">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Foreground" Value="{StaticResource BorderStrong}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel.EmptyState > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="260"/>
        </Style>

        <!-- ========================================== -->
        <!-- 3. FORM CONTROLS (TextBox / ComboBox / date pickers) -->
        <!-- ========================================== -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrandAccent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentSoft}"/>
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#A9C3F2"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BoxShadow" Value="0 0 0 4 #242E5FD1"/>
        </Style>
        <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource InputBackgroundDisabled}"/>
        </Style>

        <!-- Read-only fields (e.g. auto-filled buyer name/city) -->
        <Style Selector="TextBox.ReadOnlyField">
            <Setter Property="Background" Value="{StaticResource InputBackgroundDisabled}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style Selector="TextBox.ReadOnlyField:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundDisabled}"/>
        </Style>
        <Style Selector="TextBox.ReadOnlyField:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="Background" Value="{StaticResource InputBackgroundDisabled}"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#A9C3F2"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#PopupBorder">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="BoxShadow" Value="0 12 28 -8 #33102A4F"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SurfaceSubtle}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Compact text-plus-calendar date field. Replaces the 3-segment DatePicker. -->
        <Style Selector="CalendarDatePicker">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SelectedDateFormat" Value="Custom"/>
            <Setter Property="CustomDateFormatString" Value="dd.MM.yyyy"/>
        </Style>
        <Style Selector="CalendarDatePicker:pointerover /template/ Border#Background">
            <Setter Property="BorderBrush" Value="#A9C3F2"/>
        </Style>
        <Style Selector="CalendarDatePicker:focus-within /template/ Border#Background">
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
        </Style>

        <!-- Legacy DatePicker, kept styled in case a view still uses it -->
        <Style Selector="DatePicker">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <Style Selector="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
        </Style>

        <!-- ========================================== -->
        <!-- 4. BUTTONS                                   -->
        <!-- Gradient primary with a soft glow that lifts on hover; flat secondary/ -->
        <!-- outline/ghost variants stay quiet so the primary keeps the eye. -->
        <!-- ========================================== -->
        <Style Selector="Button.PrimaryActionBtn">
    <Setter Property="Theme" Value="{x:Null}"/>
    <Setter Property="Background" Value="{StaticResource BrandAccentGradient}"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
    <Setter Property="RenderTransform" Value="translateY(0px)"/>
    <Setter Property="Transitions">
        <Transitions>
            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
        </Transitions>
    </Setter>
    <Setter Property="Template">
        <ControlTemplate>
            <Border x:Name="Bg"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}"
                    BoxShadow="0 2 8 0 #332450B8">
                <Border.Transitions>
                    <Transitions>
                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                    </Transitions>
                </Border.Transitions>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                  TextBlock.Foreground="{TemplateBinding Foreground}"/>
            </Border>
        </ControlTemplate>
    </Setter>
</Style>
<Style Selector="Button.PrimaryActionBtn:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    <Setter Property="Opacity" Value="1"/>
</Style>
<Style Selector="Button.PrimaryActionBtn:pointerover /template/ Border#Bg">
    <Setter Property="BoxShadow" Value="0 4 12 0 #4D2450B8"/>
</Style>
<Style Selector="Button.PrimaryActionBtn:pressed">
    <Setter Property="RenderTransform" Value="translateY(0px)"/>
    <Setter Property="Opacity" Value="0.92"/>
</Style>
<Style Selector="Button.PrimaryActionBtn:disabled">
    <Setter Property="Opacity" Value="0.5"/>
    <Setter Property="RenderTransform" Value="translateY(0px)"/>
</Style>

        <!-- Secondary: white / bordered, tints to the accent on hover -->
        <Style Selector="Button.SecondaryActionBtn">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.SecondaryActionBtn:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
        </Style>
        <Style Selector="Button.SecondaryActionBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource BrandAccentHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.SecondaryActionBtn:pressed /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource BorderLight}"/>
        </Style>
        <Style Selector="Button.SecondaryActionBtn:pressed">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
        </Style>
        <Style Selector="Button.SecondaryActionBtn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Outline: transparent, accent border/text -->
        <Style Selector="Button.OutlineActionBtn">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Background="Transparent"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.OutlineActionBtn:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
        </Style>
        <Style Selector="Button.OutlineActionBtn:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Ghost link-style button, e.g. "+ Add line" -->
        <Style Selector="Button.GhostLinkBtn">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrandAccent}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.GhostLinkBtn:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
        </Style>
        <Style Selector="Button.GhostLinkBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource BrandAccentHover}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Small icon-only button, e.g. "remove row" -->
        <Style Selector="Button.IconGhostBtn">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.IconGhostBtn:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
        </Style>
        <Style Selector="Button.IconGhostBtn:pointerover">
            <Setter Property="Foreground" Value="{StaticResource BrandDanger}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- Continuous rotation for a busy/loading glyph, e.g. inside a button while a
             command runs. Apply Classes="Spin" to the PathIcon shown when IsBusy. -->
        <Style Selector="PathIcon.Spin">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Setter Property="RenderTransform">
                <RotateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Slow breathing opacity for a "live" status dot (e.g. connected to the
             database / UJP environment indicator). -->
        <Style Selector="Ellipse.PulseDot, Border.PulseDot">
            <Style.Animations>
                <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.4"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ========================================== -->
        <!-- 5. SIDEBAR / NAVIGATION                      -->
        <!-- Quiet by default: a faint wash + a small rightward slide on hover -->
        <!-- (no flat color flash), a small accent marker on the left edge plus -->
        <!-- a slightly deeper slide when selected. -->
        <!-- ========================================== -->
        <Style Selector="RadioButton.NavItem">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextMuted}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
            <!-- No reserved gutter column: the marker overlays the left edge instead of
                 permanently displacing the content. Labels stay left-aligned (so short and
                 long items share the same left edge) and the whole row slides right via the
                 RenderTransform above to make room for the marker on hover/checked. -->
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid>
                        <Border x:Name="NavBg"
                                Background="Transparent"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Transitions>
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.18"/>
                                </Transitions>
                            </Border.Transitions>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <!-- The active/hover marker: a thin rectangle running top-to-bottom
                             along the left edge, instead of a small centered dot. -->
                        <Border x:Name="Marker" Width="3"
                                CornerRadius="1.5" Margin="1,6"
                                HorizontalAlignment="Left" VerticalAlignment="Stretch"
                                Background="{StaticResource BrandAccentGradient}" Opacity="0">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.NavItem:pointerover">
            <Setter Property="RenderTransform" Value="translateX(3px)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.NavItem:pointerover /template/ Border#NavBg">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="RadioButton.NavItem:pointerover /template/ Border#Marker">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="RadioButton.NavItem:checked /template/ Border#Marker">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.NavItem:checked /template/ Border#NavBg">
            <Setter Property="Background" Value="#1EFFFFFF"/>
        </Style>
        <Style Selector="RadioButton.NavItem:checked">
            <Setter Property="Foreground" Value="{StaticResource SidebarActiveAccentText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="RenderTransform" Value="translateX(5px)"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.NavItem:disabled">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- Bottom-of-sidebar button (Settings) shares the same quiet hover language -->
        <Style Selector="Button.NavItemBtn">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarTextMuted}"/>
            <Setter Property="FontWeight" Value="DemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0%,50%"/>
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.15"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                           TextBlock.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.NavItemBtn:pointerover">
            <Setter Property="RenderTransform" Value="translateX(3px)"/>
            <Setter Property="Foreground" Value="{StaticResource SidebarText}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.NavItemBtn:pointerover /template/ Border#Bg">
            <Setter Property="Background" Value="#14FFFFFF"/>
        </Style>
        <Style Selector="Button.NavItemBtn:pressed /template/ Border#Bg">
            <Setter Property="Background" Value="#1EFFFFFF"/>
        </Style>
        <Style Selector="Button.NavItemBtn:pressed">
            <Setter Property="Foreground" Value="{StaticResource SidebarText}"/>
        </Style>

        <!-- ========================================== -->
        <!-- 6. WINDOW CHROME BUTTONS (legacy; the main window now uses the
             native caption buttons, these remain for any window that still
             draws its own) -->
        <!-- ========================================== -->
        <Style Selector="Button.WindowControlBtnStyle">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.CyanWindowBtnStyle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BorderLight}"/>
        </Style>
        <Style Selector="Button.RedWindowBtnStyle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <!-- ========================================== -->
        <!-- 7. DATAGRID                                  -->
        <!-- ========================================== -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="RowBackground" Value="{StaticResource SurfaceWhite}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource DataGridHeaderGradient}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LetterSpacing" Value="0.2"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="AreSeparatorsVisible" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridRow">
            <Setter Property="MinHeight" Value="40"/>
        </Style>
        <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{StaticResource SurfaceSubtle}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="{StaticResource AccentLight}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#FocusVisual">
            <Setter Property="Stroke" Value="{StaticResource BrandAccent}"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>
        <!-- Cells edited in place get the same input look as the rest of the form -->
        <Style Selector="DataGridCell TextBox">
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- ========================================== -->
        <!-- 8. TOTALS BOX                                -->
        <!-- ========================================== -->
        <Style Selector="Border.TotalsBox">
            <Setter Property="Background" Value="{StaticResource TotalsBoxGradient}"/>
            <Setter Property="BorderBrush" Value="#D9E6FB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style Selector="TextBlock.TotalLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="TextBlock.TotalValue">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        </Style>
        <Style Selector="TextBlock.TotalFinalLabel">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBlock.TotalFinalValue">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="LetterSpacing" Value="-0.2"/>
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        </Style>

        <!-- The grand-total pill: a saturated gradient bar with white text, the one
             loud moment on an otherwise quiet page (invoice / purchase-invoice totals). -->
        <Style Selector="Border.TotalHighlight">
            <Setter Property="Background" Value="{StaticResource TotalHighlightGradient}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="BoxShadow" Value="0 12 28 0 #4D2450B8"/>
        </Style>
        <Style Selector="TextBlock.TotalHighlightLabel">
            <Setter Property="Foreground" Value="#D9E6FF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="TextBlock.TotalHighlightValue">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.2"/>
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
        </Style>

        <!-- Stat tiles (e.g. "Total invoices" on the client screen) -->
        <Style Selector="TextBlock.StatLabel">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.5"/>
        </Style>
        <Style Selector="TextBlock.StatValue">
            <Setter Property="Foreground" Value="{StaticResource BrandText}"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="-0.2"/>
        </Style>

        <!-- ========================================== -->
        <!-- 9. STATUS BANNERS / BADGES                   -->
        <!-- ========================================== -->
        <Style Selector="Border.BannerSuccess">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="Border.BannerDanger">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style Selector="Border.BannerSuccess > TextBlock, Border.BannerDanger > TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0.3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ========================================== -->
        <!-- 10. PICKER CARDS (e.g. PDF template picker)  -->
        <!-- ========================================== -->
        <Style Selector="RadioButton.TemplateCard">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="CardBg"
                            Background="{StaticResource SurfaceWhite}"
                            BorderBrush="{StaticResource BorderLight}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                                <BrushTransition Property="Background" Duration="0:0:0.12"/>
                                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.TemplateCard:pointerover /template/ Border#CardBg">
            <Setter Property="BorderBrush" Value="#A9C3F2"/>
        </Style>
        <Style Selector="RadioButton.TemplateCard:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="RadioButton.TemplateCard:checked /template/ Border#CardBg">
            <Setter Property="BorderBrush" Value="{StaticResource BrandAccent}"/>
            <Setter Property="Background" Value="{StaticResource AccentLight}"/>
            <Setter Property="BoxShadow" Value="0 4 14 0 #262E5FD1"/>
        </Style>

        <!-- Small round color swatch (PDF accent color picker). Background is set per
             instance in the view to that color's own hex — a checked swatch gets a ring
             a couple pixels outside its circle rather than changing the swatch itself. -->
        <Style Selector="RadioButton.ColorSwatch">
            <Setter Property="Theme" Value="{x:Null}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="Ring" CornerRadius="999" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
                            </Transitions>
                        </Border.Transitions>
                        <Border CornerRadius="999" Background="{TemplateBinding Background}"
                                BorderBrush="#14000000" BorderThickness="1"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.ColorSwatch:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="RadioButton.ColorSwatch:checked /template/ Border#Ring">
            <Setter Property="BorderBrush" Value="{StaticResource BrandText}"/>
        </Style>

        <!-- ========================================== -->
        <!-- 11. ENTRANCE ANIMATIONS                      -->
        <!-- A short fade+rise on page load, with optional staggered delays (D1-D4) -->
        <!-- for the cards inside a page so they cascade in rather than pop at once. -->
        <!-- ========================================== -->
        <Style Selector="Grid.PageRoot">
            <Setter Property="RenderTransform">
                <TranslateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Duration="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="10"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.D1, Grid.D1">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <TranslateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Delay="0:0:0.05" Duration="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.D2, Grid.D2">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <TranslateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Delay="0:0:0.12" Duration="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.D3, Grid.D3">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <TranslateTransform/>
            </Setter>
            <Style.Animations>
                <Animation Delay="0:0:0.19" Duration="0:0:0.4" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="8"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Application.Styles>
</Application>
